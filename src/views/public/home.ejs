<%- include('../partials/public-header', { pageTitle, pageDescription, site, theme, navigation, currentPath }) %>
<%- include('../partials/hero', { hero, site }) %>

<section class="section section--dark-tint section--metrics">
  <div class="container">
    <div class="metrics-strip">
      <article class="metric-card">
        <strong><%= featuredProducts.length %></strong>
        <span>核心产品</span>
        <p>聚焦供水营收与漏损监测</p>
      </article>
      <article class="metric-card">
        <strong><%= featuredSolutions.length %></strong>
        <span>解决方案</span>
        <p>可复用的场景交付路径</p>
      </article>
      <article class="metric-card">
        <strong><%= latestNews.length %></strong>
        <span>新闻资讯</span>
        <p>行业动态与产品更新</p>
      </article>
      <article class="metric-card">
        <strong><%= featuredCases.length %></strong>
        <span>项目案例</span>
        <p>可追溯的实施成果</p>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">产品矩阵</p>
        <h2>支撑日常营收运营与专项治理落地</h2>
      </div>
      <p>首页直接呈现重点产品入口，便于快速跳转到详情页与后续商机沟通链路。</p>
    </div>
    <div class="card-grid card-grid--3">
      <% featuredProducts.forEach((product) => { %>
        <article class="card reveal">
          <p class="card__eyebrow">核心产品</p>
          <h2 class="card__title"><a href="<%= sitePath('/products/' + product.slug) %>"><%= product.title %></a></h2>
          <p class="card__copy"><%= product.summary %></p>
          <div class="card__actions">
            <a href="<%= sitePath('/products/' + product.slug) %>" class="text-link">查看详情 →</a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section--muted">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">方案与实践</p>
        <h2>用解决方案、项目案例与新闻形成闭环叙事</h2>
      </div>
      <p>从“我们能做什么”到“我们已经做成什么”，公开内容围绕客户最关心的业务问题和实施结果来组织。</p>
    </div>
    <div class="split-grid">
      <div class="panel panel--stack">
        <div class="panel__intro">
          <p class="card__eyebrow">解决方案</p>
          <h2>场景化交付能力</h2>
          <p>把产品能力串联成可落地的实施路径，降低客户理解与决策成本。</p>
        </div>
        <ul class="stack-list stack-list--linked">
          <% featuredSolutions.forEach((solution, i) => { %>
            <li>
              <a href="<%= sitePath('/solutions/' + solution.slug) %>">
                <span class="item-num">0<%= i + 1 %></span>
                <strong><%= solution.title %></strong>
                <span><%= solution.summary %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
      <div class="panel panel--stack">
        <div class="panel__intro">
          <p class="card__eyebrow">项目与资讯</p>
          <h2>持续更新的落地证明</h2>
          <p>新闻与案例并行展示，让品牌介绍从静态说明升级为可持续运营的内容阵地。</p>
        </div>
        <ul class="stack-list stack-list--linked">
          <% latestNews.forEach((article) => { %>
            <li>
              <a href="<%= sitePath('/news/' + article.slug) %>">
                <small class="badge badge--news">新闻</small>
                <strong><%= article.title %></strong>
                <span><%= article.summary %></span>
              </a>
            </li>
          <% }) %>
          <% featuredCases.forEach((item) => { %>
            <li>
              <a href="<%= sitePath('/cases/' + item.slug) %>">
                <small class="badge badge--case">案例</small>
                <strong><%= item.title %></strong>
                <span><%= item.summary %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section section--cta">
  <div class="container">
    <div class="cta-box">
      <p class="eyebrow">立即行动</p>
      <h2>准备好开始数字化转型了吗？</h2>
      <p>联系我们的专家团队，获取针对您业务场景的解决方案。</p>
      <div class="button-stack">
        <a href="<%= sitePath('/contact') %>" class="button button--primary">预约方案咨询</a>
        <a href="<%= sitePath('/products') %>" class="button button--secondary">浏览产品矩阵</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/public-footer', { site, navigation }) %>
