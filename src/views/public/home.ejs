<%- include('../partials/public-header', { pageTitle, pageDescription, site, theme, navigation, currentPath }) %>
<%- include('../partials/hero', { hero, site }) %>

<section class="section section--muted section--metrics">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">内容矩阵</p>
        <h2>围绕真实业务场景组织公开内容</h2>
      </div>
      <p>两套品牌站点共用同一套后台维护产品、方案、新闻与案例，让内容更新更稳定，也更适合后续自建部署与持续运营。</p>
    </div>
    <div class="metrics-strip">
      <article class="metric-card">
        <span>核心产品</span>
        <strong><%= featuredProducts.length %></strong>
        <p>聚焦供水营收治理、分区漏损监测与现场作业支撑。</p>
      </article>
      <article class="metric-card">
        <span>解决方案</span>
        <strong><%= featuredSolutions.length %></strong>
        <p>把设备采集、业务流程与项目交付经验沉淀为可复用路径。</p>
      </article>
      <article class="metric-card">
        <span>新闻资讯</span>
        <strong><%= latestNews.length %></strong>
        <p>同步项目进展、行业观察与产品更新，形成持续输出节奏。</p>
      </article>
      <article class="metric-card">
        <span>项目案例</span>
        <strong><%= featuredCases.length %></strong>
        <p>用可追溯的实施成果支撑品牌可信度与后续商务沟通。</p>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">产品矩阵</p>
        <h2>支撑日常营收运营与专项治理落地</h2>
      </div>
      <p>首页直接呈现重点产品入口，便于从品牌首页快速跳转到详情页、资料下载页与后续商机沟通链路。</p>
    </div>
    <div class="card-grid card-grid--3">
      <% featuredProducts.forEach((product) => { %>
        <article class="card">
          <p class="card__eyebrow">核心产品</p>
          <h2 class="card__title"><a href="/products/<%= product.slug %>"><%= product.title %></a></h2>
          <p class="card__copy"><%= product.summary %></p>
          <div class="card__actions">
            <a href="/products/<%= product.slug %>" class="text-link">查看详情</a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section--muted">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">方案与实践</p>
        <h2>用解决方案、项目案例与新闻形成闭环叙事</h2>
      </div>
      <p>从“我们能做什么”到“我们已经做成什么”，公开内容围绕客户最关心的业务问题和实施结果来组织。</p>
    </div>
    <div class="split-grid">
      <div class="panel panel--stack">
        <div class="panel__intro">
          <p class="card__eyebrow">解决方案</p>
          <h2>场景化交付能力</h2>
          <p>把产品能力串联成可落地的实施路径，降低客户理解与决策成本。</p>
        </div>
        <ul class="stack-list stack-list--linked">
          <% featuredSolutions.forEach((solution) => { %>
            <li>
              <a href="/solutions/<%= solution.slug %>">
                <small>解决方案</small>
                <strong><%= solution.title %></strong>
                <span><%= solution.summary %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
      <div class="panel panel--stack">
        <div class="panel__intro">
          <p class="card__eyebrow">项目与资讯</p>
          <h2>持续更新的落地证明</h2>
          <p>新闻与案例并行展示，让品牌介绍从静态说明升级为可持续运营的内容阵地。</p>
        </div>
        <ul class="stack-list stack-list--linked">
          <% latestNews.forEach((article) => { %>
            <li>
              <a href="/news/<%= article.slug %>">
                <small>新闻资讯</small>
                <strong><%= article.title %></strong>
                <span><%= article.summary %></span>
              </a>
            </li>
          <% }) %>
          <% featuredCases.forEach((item) => { %>
            <li>
              <a href="/cases/<%= item.slug %>">
                <small>客户案例</small>
                <strong><%= item.title %></strong>
                <span><%= item.summary %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/public-footer', { site, navigation }) %>
