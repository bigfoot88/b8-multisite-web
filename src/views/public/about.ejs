<%- include('../partials/public-header', { pageTitle, pageDescription, site, theme, navigation, currentPath }) %>
<%- include('../partials/hero', { hero, site }) %>

<section class="section">
  <div class="container prose-shell prose-shell--fullwidth">
    <article class="prose-card prose-card--fullwidth">
      <% if (page.summary) { %><p class="lead lead--compact"><%= page.summary %></p><% } %>
      <div class="rich-text"><%- page.bodyHtml || '' %></div>
    </article>
  </div>
</section>

<%- include('../partials/public-footer', { site, navigation }) %>
