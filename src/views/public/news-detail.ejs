<%- include('../partials/public-header', { pageTitle, pageDescription, site, theme, navigation, currentPath }) %>

<% const coverAsset = article?.heroAsset || (typeof heroAsset !== 'undefined' ? heroAsset : null); %>
<div class="article-header">
  <% if (coverAsset && coverAsset.publicUrl) { %>
    <div class="article-header__cover">
      <img
        class="article-header__cover-img"
        src="<%= coverAsset.publicUrl %>"
        alt="<%= coverAsset.altText || article.title %>"
      />
    </div>
  <% } %>
  <div class="container article-header__meta">
    <p class="eyebrow">新闻详情</p>
    <h1 class="article-header__title"><%= article.title %></h1>
    <% if (article.summary) { %>
      <p class="article-header__summary"><%= article.summary %></p>
    <% } %>
    <% if (article.publishedAt || article.createdAt) { %>
      <p class="article-header__date"><%= new Date(article.publishedAt || article.createdAt).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <% } %>
  </div>
</div>

<section class="section">
  <div class="container prose-shell">
    <article class="prose-card">
      <div class="rich-text"><%- article.bodyHtml || '' %></div>
    </article>
  </div>
</section>

<%- include('../partials/public-footer', { site, navigation }) %>
