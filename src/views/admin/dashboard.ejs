<div class="admin-grid">
  <% if (!currentSection) { %>
    <section class="admin-panel">
      <h2>常用入口</h2>
      <div class="admin-card-list">
        <% siteSummaries.forEach((site) => { %>
          <a class="admin-card" href="<%= site.href %>">
            <strong><%= site.label %></strong>
            <p><%= site.description %></p>
          </a>
        <% }) %>
        <a class="admin-card" href="/admin/media">
          <strong>媒体库</strong>
          <p>集中访问上传素材、图片与附件。</p>
        </a>
      </div>
    </section>
  <% } else { %>
    <section class="admin-panel">
      <h2>当前入口</h2>
      <p>此页面已准备好作为后续内容管理入口，当前阶段仅提供认证后的中文管理壳层。</p>
      <ul class="admin-checklist">
        <li>已完成登录鉴权</li>
        <li>已接通规范化后台地址</li>
        <li>已预留后续 CRUD 页面挂载位</li>
      </ul>
    </section>
  <% } %>

  <section class="admin-panel">
    <h2>后台说明</h2>
    <p>当前版本聚焦登录与导航结构，后续会在对应入口下补齐页面、产品、解决方案、新闻、案例与媒体管理功能。</p>
  </section>
</div>
