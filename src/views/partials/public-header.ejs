<!DOCTYPE html>
<html lang="zh-CN" data-site-theme="<%= theme?.name || 'default' %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <% if (pageDescription) { %>
      <meta name="description" content="<%= pageDescription %>" />
    <% } %>
    <link rel="stylesheet" href="/css/public.css" />
    <link rel="stylesheet" href="/css/themes.css" />
    <script src="/js/site.js" defer></script>
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div class="site-shell">
      <div class="header-topbar"></div>
      <header class="site-header">
        <div class="container site-header__inner">
          <% const primaryCtaHref = site ? '/contact' : '/'; %>
          <% const primaryCtaLabel = site ? '预约咨询' : '返回首页'; %>
          <a class="site-brand" href="<%= sitePath('/') %>">
            <span class="site-brand__mark"><%= theme?.label || 'B8' %></span>
            <span>
              <strong><%= site?.brandName || 'B8 Multisite' %></strong>
              <small><%= site?.tagline || theme?.accent || '多站点内容平台' %></small>
            </span>
          </a>

          <button
            type="button"
            class="nav-toggle"
            data-nav-toggle
            aria-expanded="false"
            aria-controls="site-navigation"
            aria-label="切换导航菜单"
          >
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
          </button>

          <nav class="site-nav" id="site-navigation" data-nav-menu>
            <ul>
              <% (navigation || []).forEach((item) => { %>
                <li>
                  <a
                    href="<%= sitePath(item.href) %>"
                    class="<%= currentPath === item.href ? 'is-active' : '' %>"
                  ><%= item.label %></a>
                </li>
              <% }) %>
            </ul>
          </nav>

          <div class="site-header__actions">
            <% if (site?.contactPhone) { %>
              <a class="site-quick-contact" href="tel:<%= site.contactPhone %>">
                <span>咨询热线</span>
                <strong><%= site.contactPhone %></strong>
              </a>
            <% } %>
            <a href="<%= sitePath(primaryCtaHref) %>" class="button button--primary site-header__cta"><%= primaryCtaLabel %></a>
          </div>
        </div>
      </header>
      <main id="main-content">
